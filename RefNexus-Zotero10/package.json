{
  "name": "zotero-refnexus",
  "version": "10.3.2",
  "description": "Zotero 10 reference retrieval and citation graphs, derived from Zotero Reference / Ethereal Reference by Polygon / MuiseDestiny.",
  "config": {
    "addonName": "Zotero RefNexus",
    "addonID": "refnexus@polygon.org",
    "addonRef": "refnexus",
    "addonInstance": "ZoteroRefNexus",
    "downloadURL": "https://raw.githubusercontent.com/groele/Zotero-diy/main/RefNexus-Zotero10/zotero-refnexus.xpi",
    "updateURL": "https://raw.githubusercontent.com/groele/Zotero-diy/main/RefNexus-Zotero10/update.json",
    "issuesURL": "https://github.com/groele/Zotero-diy/issues",
    "upstreamURL": "https://github.com/MuiseDestiny/zotero-reference"
  },
  "main": "src/index.ts",
  "scripts": {
    "build-dev": "cross-env NODE_ENV=development node scripts/build.mjs",
    "build-prod": "cross-env NODE_ENV=production node scripts/build.mjs",
    "build": "concurrently -c auto npm:build-prod npm:tsc",
    "tsc": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "native:fixtures": "python scripts/make-native-fixtures.py",
    "native:test": "pwsh -NoProfile -File scripts/run-isolated-native.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/groele/Zotero-diy.git"
  },
  "author": "groele",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/groele/Zotero-diy/issues"
  },
  "homepage": "https://github.com/groele/Zotero-diy/tree/main/RefNexus-Zotero10",
  "dependencies": {
    "connectedpapers-js": "^0.1.5",
    "d3": "^7.8.2",
    "zotero-plugin-toolkit": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.13.0",
    "compressing": "^1.7.0",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.17.7",
    "replace-in-file": "^6.3.5",
    "typescript": "^4.9.5",
    "zotero-types": "^1.0.9"
  },
  "contributors": [
    {
      "name": "Polygon / MuiseDestiny",
      "url": "https://github.com/MuiseDestiny"
    }
  ]
}
